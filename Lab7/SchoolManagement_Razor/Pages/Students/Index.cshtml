@page
@model SchoolManagement_Razor.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🎓 Students Management (Database First)</h2>
    <a asp-page="Create" class="btn btn-primary">➕ Create New Student</a>
</div>

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Student ID</th>
            <th>Last Name</th>
            <th>First Name</th>
            <th>Enrollment Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Students) {
        <tr>
            <td>@item.StudentId</td>
            <td>@item.LastName</td>
            <td>@item.FirstMidName</td>
            <td>@item.EnrollmentDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-page="./Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-page="./Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
